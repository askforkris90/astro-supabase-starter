---
import type { Framework } from "../utils/types";

interface Props {
  framework: Framework;
}

const { framework } = Astro.props;
---

<tr class="border-b border-neutral-600">
  <td class="text-xl font-bold">{framework.name}</td>
  <td>
    <img
      src={framework.logo.startsWith('http') ? framework.logo : `/.netlify/images?url=/images/${framework.logo}`}
      class="w-32"
      alt={framework.name}
    />
  </td>
  <td>{framework.likes} like{framework.likes === 1 ? "" : "s"}</td>
  <td><a href={`/frameworks/${framework.slug}`} class="underline">Learn more &rarr;</a></td>
</tr>
