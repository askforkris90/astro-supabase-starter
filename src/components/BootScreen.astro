  // Open window
  function openWindow(appName: string) {
    if (openWindows[appName]) {
      // Focus existing window
      openWindows[appName].style.zIndex = (++windowZIndex).toString();
      return;
    }

    const app = windowContent[appName];
    if (!app) return;

    const window = document.createElement('div');
    window.className = 'window';
    window.style.zIndex = (++windowZIndex).toString();
    window.style.left = `${50 + Object.keys(openWindows).length * 30}px`;
    window.style.top = `${50 + Object.keys(openWindows).length * 30}px`;
    window.style.width = '500px';
    window.style.height = '400px';

    window.innerHTML = `
      <div class="window-header">
        <div class="window-title">
          <span>${app.icon}</span>
          <span>${app.title}</span>
        </div>
        <div class="window-controls">
          <button class="window-btn minimize"></button>
          <button class="window-btn maximize"></button>
          <button class="window-btn close"></button>
        </div>
      </div>
      <div class="window-content">
        ${app.content}
      </div>
    `;

    // Close button
    const closeBtn = window.querySelector('.window-btn.close');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        window.remove();
        delete openWindows[appName];
        updateTaskbar();
      });
    }

    // Focus on click
    window.addEventListener('mousedown', () => {
      window.style.zIndex = (++windowZIndex).toString();
    });

    // Dragging
    const header = window.querySelector('.window-header') as HTMLElement;
    if (header) {
      let isDragging = false;
      let offsetX = 0;
      let offsetY = 0;

      header.addEventListener('mousedown', (e) => {
        isDragging = true;
        offsetX = e.clientX - window.offsetLeft;
        offsetY = e.clientY - window.offsetTop;
      });

      document.addEventListener('mousemove', (e) => {
        if (isDragging) {
          window.style.left = `${e.clientX - offsetX}px`;
          window.style.top = `${e.clientY - offsetY}px`;
        }
      });

      document.addEventListener('mouseup', () => {
        isDragging = false;
      });
    }

    if (windowContainer) windowContainer.appendChild(window);
    openWindows[appName] = window;
    updateTaskbar();
  }

  // Update taskbar with open apps
  function updateTaskbar() {
    if (!taskbarApps) return;
    taskbarApps.innerHTML = '';

    Object.keys(openWindows).forEach(appName => {
      const app = windowContent[appName];
      if (!app) return;

      const btn = document.createElement('button');
      btn.className = 'taskbar-app active';
      btn.innerHTML = `${app.icon} ${app.title}`;
      btn.addEventListener('click', () => {
        openWindows[appName].style.zIndex = (++windowZIndex).toString();
      });
      taskbarApps.appendChild(btn);
    });
  }

  // Start boot sequence on load
  document.addEventListener('DOMContentLoaded', initBootSequence);
</script>
