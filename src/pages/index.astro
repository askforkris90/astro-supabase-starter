---
import BootLayout from "../components/BootLayout.astro";

const recommendations = [
  {
    title: "Paddle Checkout",
    description: "Primary payment flow with Paddle-hosted checkout.",
  },
  {
    title: "Paddle Subscriptions",
    description: "Recurring plans and license renewals are highlighted.",
  },
  {
    title: "Tax & Compliance",
    description: "Merchant-of-record handling for global tax coverage.",
  },
  {
    title: "Localized Pricing",
    description: "Regional pricing cues for international shoppers.",
  },
];

const paymentMethods = [
  {
    label: "Apple Pay",
    detail: "Tap-ready wallets",
    icon: "AP",
    tone: "apple",
  },
  {
    label: "Google Pay",
    detail: "Android checkout",
    icon: "GP",
    tone: "google",
  },
  {
    label: "Cards",
    detail: "Visa • MC • Amex",
    icon: "CC",
    tone: "cards",
  },
  {
    label: "Bank Transfer",
    detail: "Invoice flows",
    icon: "ACH",
    tone: "bank",
  },
];

const promoTiles = [
  {
    title: "Featured Drop",
    detail: "Holo Jackets • Limited run",
  },
  {
    title: "In-Store Only",
    detail: "Bundle pricing + instant setup",
  },
  {
    title: "Demo Loop",
    detail: "Live catalog + checkout prompts",
  },
];
---

<BootLayout title="KashOS Store Display">
  <section class="relative min-h-screen bg-black text-white">
    <div
      id="bootScreen"
      class="absolute inset-0 grid place-items-center transition-opacity duration-700"
    >
      <div class="absolute inset-0 boot-glow"></div>
      <div class="relative z-10 flex flex-col items-center gap-6 text-center px-6">
        <div class="kashos-logo text-5xl sm:text-6xl tracking-[0.2em] uppercase">
          KashOS
        </div>
        <p class="text-lg sm:text-xl text-neutral-200 max-w-lg">
          Store display boot sequence for kashos.digital
        </p>
        <div id="bootFrame" class="boot-frame">
          <video
            id="bootVideo"
            class="boot-video"
            autoplay
            muted
            playsinline
            preload="auto"
            poster="/boot-poster.jpg"
          >
            <source src="/boot.webm" type="video/webm" />
            <source src="/boot.mp4" type="video/mp4" />
          </video>
          <div class="boot-fallback">
            <div class="boot-scan"></div>
            <div class="boot-status">
              Loading storefront experience
              <span class="boot-dots" aria-hidden="true"></span>
            </div>
          </div>
        </div>
        <button
          id="skipBoot"
          class="rounded-full border border-neutral-500 px-5 py-2 text-sm uppercase tracking-[0.25em] hover:border-white hover:text-white transition"
          type="button"
        >
          Skip Boot
        </button>
      </div>
    </div>

    <div
      id="osScreen"
      class="absolute inset-0 hidden opacity-0 transition-opacity duration-700"
    >
      <div class="os-shell">
        <header class="os-bar">
          <div class="flex items-center gap-3">
            <span class="os-dot"></span>
            <span class="os-dot os-dot--amber"></span>
            <span class="os-dot os-dot--green"></span>
            <span class="text-sm tracking-[0.4em] uppercase text-neutral-300">
              KashOS
            </span>
          </div>
          <div class="flex items-center gap-6 text-xs uppercase tracking-[0.35em] text-neutral-300">
            <span>Storefront</span>
            <span id="osTime">--:--</span>
            <button
              id="contrastToggle"
              class="os-contrast-toggle"
              type="button"
              aria-pressed="false"
            >
              High Contrast
            </button>
          </div>
        </header>
        <div class="os-content">
          <section class="os-hero">
            <div>
              <p class="text-xs uppercase tracking-[0.5em] text-neutral-400">
                Active Mode
              </p>
              <h1 class="text-4xl sm:text-5xl font-semibold">
                Storefront OS Display
              </h1>
            </div>
            <p class="text-sm sm:text-base text-neutral-300 max-w-md">
              A looping retail showcase for product reels, live catalog tiles,
              and Paddle-powered checkout prompts. Swap the boot video per
              campaign.
            </p>
          </section>
          <section class="os-cta">
            <div>
              <p class="text-xs uppercase tracking-[0.45em] text-neutral-400">
                Call to Action
              </p>
              <p class="text-lg">Invite shoppers to continue on kiosk.</p>
            </div>
            <div class="os-cta-actions">
              <button class="os-cta-primary" type="button">
                Start Guided Demo
              </button>
              <button class="os-cta-secondary" type="button">
                Scan for Checkout
              </button>
            </div>
          </section>
          <section class="os-recommendations">
            <div class="os-section-header">
              <p class="text-xs uppercase tracking-[0.5em] text-neutral-400">
                Paddle
              </p>
              <p class="text-sm text-neutral-300">
                Checkout highlights tailored for Paddle-powered sales.
              </p>
            </div>
            <div class="os-grid">
              {recommendations.map((item) => (
                <article class="os-card">
                  <h2>{item.title}</h2>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
            <div class="os-payment-strip">
              <div>
                <p class="text-xs uppercase tracking-[0.4em] text-neutral-400">
                  Suggested Payments
                </p>
                <p class="text-sm text-neutral-300">
                  Visual tiles for the most requested checkout methods.
                </p>
              </div>
              <div class="os-payment-grid">
                {paymentMethods.map((method) => (
                  <article class="os-payment-card">
                    <div
                      class={`os-payment-icon os-payment-icon--${method.tone}`}
                      aria-hidden="true"
                    >
                      <span>{method.icon}</span>
                    </div>
                    <div>
                      <p class="os-payment-label">{method.label}</p>
                      <p class="os-payment-detail">{method.detail}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
          <section class="os-strip">
            <div>
              <p class="text-xs uppercase tracking-[0.4em] text-neutral-400">
                Featured Promos
              </p>
              <p class="text-lg">Rotating spotlight tiles for retail loops.</p>
            </div>
            <div class="os-promo-track">
              {promoTiles.map((tile) => (
                <article class="os-promo-card">
                  <p class="os-promo-title">{tile.title}</p>
                  <p class="os-promo-detail">{tile.detail}</p>
                </article>
              ))}
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <script>
    const bootScreen = document.getElementById("bootScreen");
    const osScreen = document.getElementById("osScreen");
    const bootVideo = document.getElementById("bootVideo");
    const bootFrame = document.getElementById("bootFrame");
    const skipBoot = document.getElementById("skipBoot");
    const osTime = document.getElementById("osTime");

    const showOs = () => {
      if (!bootScreen || !osScreen) return;
      bootScreen.classList.add("opacity-0");
      osScreen.classList.remove("hidden");
      requestAnimationFrame(() => {
        osScreen.classList.remove("opacity-0");
        osScreen.classList.add("opacity-100");
        osScreen.classList.add("is-ready");
      });
      setTimeout(() => {
        bootScreen.classList.add("hidden");
      }, 700);
    };

    const updateTime = () => {
      if (!osTime) return;
      const now = new Date();
      osTime.textContent = now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
      });
    };

    updateTime();
    setInterval(updateTime, 30000);

    const fallbackTimer = setTimeout(showOs, 8500);

    if (bootVideo) {
      bootVideo.addEventListener("canplay", () => {
        if (bootFrame) bootFrame.classList.add("is-playing");
      });
      bootVideo.addEventListener("ended", () => {
        clearTimeout(fallbackTimer);
        showOs();
      });
      bootVideo.addEventListener("error", () => {
        clearTimeout(fallbackTimer);
        showOs();
      });
    }

    if (skipBoot) {
      skipBoot.addEventListener("click", () => {
        clearTimeout(fallbackTimer);
        showOs();
      });
    }

    const contrastToggle = document.getElementById("contrastToggle");
    if (contrastToggle) {
      contrastToggle.addEventListener("click", () => {
        document.body.classList.toggle("high-contrast");
        contrastToggle.setAttribute(
          "aria-pressed",
          document.body.classList.contains("high-contrast").toString()
        );
      });
    }

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" || event.key === " ") {
        clearTimeout(fallbackTimer);
        showOs();
      }
    });
  </script>

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Unbounded:wght@500;700&display=swap");

    :root {
      color-scheme: dark;
    }

    body {
      font-family: "Space Grotesk", "Segoe UI", sans-serif;
    }

    .kashos-logo {
      font-family: "Unbounded", "Space Grotesk", sans-serif;
    }

    .boot-glow {
      background: radial-gradient(circle at top, rgba(112, 255, 200, 0.35), transparent 55%),
        radial-gradient(circle at 30% 80%, rgba(120, 80, 255, 0.35), transparent 60%),
        linear-gradient(120deg, rgba(15, 15, 20, 0.95), rgba(5, 5, 8, 0.98));
      filter: blur(0);
    }

    .boot-frame {
      position: relative;
      width: min(720px, 90vw);
      aspect-ratio: 16 / 9;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      background: #0d0d12;
    }

    .boot-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .boot-fallback {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(14, 16, 24, 0.92), rgba(6, 6, 10, 0.98));
      color: rgba(255, 255, 255, 0.8);
      text-transform: uppercase;
      letter-spacing: 0.45em;
      font-size: 0.7rem;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .boot-frame.is-playing .boot-fallback {
      opacity: 0;
    }

    .boot-scan {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 0%,
        rgba(120, 255, 220, 0.1) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      animation: boot-scan 3s linear infinite;
      opacity: 0.8;
    }

    .boot-status {
      position: relative;
      z-index: 1;
    }

    .boot-dots::after {
      content: "";
      display: inline-block;
      width: 1.8em;
      animation: boot-dots 1.4s steps(3, end) infinite;
      text-align: left;
    }

    .os-shell {
      height: 100%;
      background: radial-gradient(circle at top right, rgba(90, 160, 255, 0.25), transparent 45%),
        radial-gradient(circle at left, rgba(120, 255, 200, 0.2), transparent 55%),
        #0b0b10;
      display: flex;
      flex-direction: column;
    }

    .os-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(8, 8, 12, 0.85);
      backdrop-filter: blur(18px);
    }

    .os-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #ff5f56;
      box-shadow: 0 0 8px rgba(255, 95, 86, 0.6);
    }

    .os-dot--amber {
      background: #ffbd2e;
      box-shadow: 0 0 8px rgba(255, 189, 46, 0.6);
    }

    .os-dot--green {
      background: #27c93f;
      box-shadow: 0 0 8px rgba(39, 201, 63, 0.6);
    }

    .os-content {
      flex: 1;
      padding: 2.5rem clamp(1.5rem, 6vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .os-hero {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .os-recommendations {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .os-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 2rem;
      padding: 1.4rem 1.6rem;
      border-radius: 20px;
      background: rgba(18, 20, 28, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    .os-cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .os-cta-primary,
    .os-cta-secondary {
      border-radius: 999px;
      padding: 0.75rem 1.4rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      font-size: 0.7rem;
      border: 1px solid transparent;
      transition: transform 0.3s ease, border-color 0.3s ease,
        box-shadow 0.3s ease;
    }

    .os-cta-primary {
      background: linear-gradient(135deg, rgba(120, 255, 200, 0.25), rgba(90, 160, 255, 0.35));
      border-color: rgba(120, 255, 200, 0.5);
      box-shadow: 0 8px 24px rgba(90, 160, 255, 0.25);
    }

    .os-cta-secondary {
      background: rgba(12, 14, 20, 0.9);
      border-color: rgba(255, 255, 255, 0.2);
      color: rgba(255, 255, 255, 0.85);
    }

    .os-cta-primary:hover,
    .os-cta-secondary:hover {
      transform: translateY(-2px);
    }

    .os-section-header {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .os-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.5rem;
    }

    .os-card {
      padding: 1.5rem;
      border-radius: 20px;
      background: rgba(14, 16, 22, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
      transition: transform 0.4s ease, border 0.4s ease;
    }

    .os-card h2 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .os-card p {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9rem;
    }

    .os-card:hover {
      transform: translateY(-6px);
      border-color: rgba(120, 255, 220, 0.4);
    }

    .os-payment-strip {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      padding: 1.4rem;
      border-radius: 22px;
      background: rgba(12, 14, 20, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .os-payment-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
    }

    .os-payment-card {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: 1rem 1.1rem;
      border-radius: 16px;
      background: rgba(16, 18, 26, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.35s ease, border-color 0.35s ease;
    }

    .os-payment-card:hover {
      transform: translateY(-4px);
      border-color: rgba(90, 160, 255, 0.45);
    }

    .os-payment-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(90, 160, 255, 0.6), rgba(120, 255, 200, 0.5));
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
      display: grid;
      place-items: center;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.18em;
    }

    .os-payment-icon--apple {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(120, 255, 200, 0.4));
    }

    .os-payment-icon--google {
      background: linear-gradient(135deg, rgba(90, 160, 255, 0.7), rgba(255, 220, 120, 0.35));
    }

    .os-payment-icon--cards {
      background: linear-gradient(135deg, rgba(120, 255, 200, 0.6), rgba(90, 160, 255, 0.45));
    }

    .os-payment-icon--bank {
      background: linear-gradient(135deg, rgba(255, 220, 120, 0.45), rgba(120, 255, 200, 0.4));
    }

    .os-payment-label {
      font-size: 0.95rem;
      font-weight: 600;
    }

    .os-payment-detail {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.65);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .os-strip {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      align-items: flex-start;
      border-radius: 18px;
      padding: 1.2rem 1.8rem;
      background: rgba(10, 12, 18, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .os-promo-track {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
    }

    .os-promo-card {
      padding: 1rem 1.2rem;
      border-radius: 16px;
      background: rgba(16, 18, 26, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.35s ease, border-color 0.35s ease;
      animation: promo-float 6s ease-in-out infinite;
    }

    .os-promo-card:nth-child(2) {
      animation-delay: 1.6s;
    }

    .os-promo-card:nth-child(3) {
      animation-delay: 3.2s;
    }

    .os-promo-title {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
    }

    .os-promo-detail {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.65);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .os-contrast-toggle {
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 0.35rem 0.9rem;
      font-size: 0.6rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.8);
      transition: border-color 0.3s ease, color 0.3s ease;
    }

    .os-contrast-toggle:hover {
      border-color: rgba(255, 255, 255, 0.5);
      color: #fff;
    }

    #osScreen .os-card,
    #osScreen .os-payment-card,
    #osScreen .os-payment-strip,
    #osScreen .os-cta,
    #osScreen .os-strip,
    #osScreen .os-hero {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    #osScreen.is-ready .os-hero {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.1s;
    }

    #osScreen.is-ready .os-cta {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.2s;
    }

    #osScreen.is-ready .os-payment-strip {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.45s;
    }

    #osScreen.is-ready .os-strip {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.6s;
    }

    #osScreen.is-ready .os-card,
    #osScreen.is-ready .os-payment-card {
      opacity: 1;
      transform: translateY(0);
    }

    #osScreen.is-ready .os-card:nth-child(1) {
      transition-delay: 0.25s;
    }

    #osScreen.is-ready .os-card:nth-child(2) {
      transition-delay: 0.32s;
    }

    #osScreen.is-ready .os-card:nth-child(3) {
      transition-delay: 0.39s;
    }

    #osScreen.is-ready .os-card:nth-child(4) {
      transition-delay: 0.46s;
    }

    #osScreen.is-ready .os-payment-card:nth-child(1) {
      transition-delay: 0.5s;
    }

    #osScreen.is-ready .os-payment-card:nth-child(2) {
      transition-delay: 0.56s;
    }

    #osScreen.is-ready .os-payment-card:nth-child(3) {
      transition-delay: 0.62s;
    }

    #osScreen.is-ready .os-payment-card:nth-child(4) {
      transition-delay: 0.68s;
    }

    body.high-contrast {
      color-scheme: dark;
    }

    body.high-contrast .os-shell {
      background: radial-gradient(circle at top right, rgba(120, 255, 220, 0.3), transparent 40%),
        radial-gradient(circle at left, rgba(255, 220, 120, 0.2), transparent 55%),
        #050508;
    }

    body.high-contrast .os-bar,
    body.high-contrast .os-card,
    body.high-contrast .os-payment-card,
    body.high-contrast .os-payment-strip,
    body.high-contrast .os-cta,
    body.high-contrast .os-strip,
    body.high-contrast .os-promo-card {
      border-color: rgba(255, 255, 255, 0.35);
      background: rgba(6, 8, 12, 0.95);
    }

    body.high-contrast .os-cta-primary {
      background: linear-gradient(135deg, rgba(120, 255, 200, 0.4), rgba(90, 160, 255, 0.6));
      border-color: rgba(120, 255, 200, 0.85);
    }

    body.high-contrast .os-cta-secondary {
      border-color: rgba(255, 255, 255, 0.6);
      color: #fff;
    }

    body.high-contrast .os-payment-icon {
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    }

    @keyframes boot-scan {
      0% {
        transform: translateY(-100%);
      }
      100% {
        transform: translateY(100%);
      }
    }

    @keyframes boot-dots {
      0% {
        content: "";
      }
      33% {
        content: ".";
      }
      66% {
        content: "..";
      }
      100% {
        content: "...";
      }
    }

    @keyframes promo-float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-6px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }

      .os-card:hover,
      .os-payment-card:hover,
      .os-cta-primary:hover,
      .os-cta-secondary:hover {
        transform: none;
      }
    }
  </style>
</BootLayout>
