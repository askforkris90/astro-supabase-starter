---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../utils/database";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  throw new Error("No framework id provided");
}

// Fetch pet data from Supabase if connection is set up
let framework;
if (supabase) {
  const { data, error } = await supabase
    .from("frameworks")
    .select("*")
    .eq("id", id)
    .single();
  framework = data ? data : null;
  if (error || !framework) {
    console.error(error);
    throw new Error("No framework found");
  }
}

const purchaseContacts = [
  {
    name: "Sales Desk",
    role: "Licensing + volume pricing",
    email: "sales@kashos.digital",
  },
  {
    name: "Accounts Team",
    role: "Invoices + procurement",
    email: "accounts@kashos.digital",
  },
  {
    name: "Support Line",
    role: "Activation + renewals",
    email: "support@kashos.digital",
  },
];
---

<Layout title={`${framework?.name} | Frameworks`}>
  <article class="border-b pb-14 border-neutral-600">
    <header
      class="flex flex-wrap items-center justify-between pb-2 mb-8 border-b"
    >
      <h1 class="mb-4 text-5xl font-bold">{framework?.name}</h1>
      <a href={framework?.url} class="underline">Website &#8599;</a>
    </header>

    <figure>
      <img
        src={`/.netlify/images?url=/images/${framework?.logo}`}
        alt={framework?.name}
        class="mb-2 border rounded-sm border-neutral-500"
      />
      <figcaption class="font-mono text-xs">{framework?.name} logo</figcaption>
    </figure>

    <p class="py-6 text-xl">{framework?.description}</p>

    <form action={`/api/frameworks/${framework?.id}/like`} method="post">
      <h2 class="mb-2 text-2xl">Like {framework?.name}!</h2>

      <p class="mb-4">
        {framework?.name} has {framework?.likes} like{
          framework?.likes === 1 ? "" : "s"
        }.
      </p>

      <button type="submit" class="px-4 py-2 bg-green-500 rounded-sm text-neutral-800 hover:bg-green-600">Give {framework?.name} your vote &starf;</button>
    </form>

    <div class="mt-8 pt-8 border-t border-neutral-600">
      <h2 class="mb-2 text-2xl">Purchase License</h2>
      <p class="mb-4">Get a commercial license for {framework?.name}.</p>
      <button
        id="checkout-btn"
        data-framework={JSON.stringify(framework)}
        class="px-4 py-2 bg-blue-500 rounded-sm text-white hover:bg-blue-600 transition-colors"
      >
        Buy Now &rarr;
      </button>
      <div class="mt-6 border-t border-neutral-700 pt-6">
        <h3 class="mb-3 text-lg font-semibold">Purchase Contacts</h3>
        <div class="grid gap-4 md:grid-cols-3">
          {purchaseContacts.map((contact) => (
            <article class="rounded-sm border border-neutral-600 bg-neutral-900/40 p-4">
              <p class="text-sm uppercase tracking-[0.18em] text-neutral-400">
                {contact.role}
              </p>
              <p class="mt-2 text-lg font-semibold">{contact.name}</p>
              <a
                href={`mailto:${contact.email}`}
                class="mt-3 inline-flex text-sm underline"
              >
                {contact.email}
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>

    <script>
      import { jsPDF } from "jspdf";

      const checkoutBtn = document.getElementById("checkout-btn");
      if (checkoutBtn) {
        checkoutBtn.addEventListener("click", async () => {
          const frameworkData = checkoutBtn.dataset.framework;
          if (frameworkData) {
            try {
              const framework = JSON.parse(frameworkData);
              
              // 1. Call API to create transaction
              const response = await fetch("/api/transactions/create", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  framework_id: framework.id,
                }),
              });

              if (!response.ok) {
                // If API fails (e.g. no DB), fall back to local-only for demo purposes?
                // Or throw error?
                // For this request, we want "extended implementation" so we expect it to work.
                // But let's be robust: if it's 503 (DB unavailable), we might want to warn.
                const err = await response.json();
                throw new Error(err.error || "Failed to create transaction");
              }

              const transaction = await response.json();

              // 2. Generate PDF Invoice
              const doc = new jsPDF();
              
              doc.setFontSize(20);
              doc.text("INVOICE", 105, 20, { align: "center" });
              
              doc.setFontSize(12);
              doc.text(`Invoice ID: ${transaction.id}`, 20, 40);
              doc.text(`Date: ${new Date(transaction.purchased_at).toLocaleDateString()}`, 20, 50);
              doc.text(`Status: ${transaction.status.toUpperCase()}`, 20, 60);
              
              doc.text("Item", 20, 80);
              doc.text("Price", 160, 80);
              doc.line(20, 85, 190, 85);
              
              doc.text(framework.name + " Commercial License", 20, 95);
              doc.text(`$${transaction.amount}`, 160, 95);
              
              doc.line(20, 110, 190, 110);
              doc.setFontSize(14);
              doc.text("Total", 120, 120);
              doc.text(`$${transaction.amount}`, 160, 120);
              
              doc.save(`invoice_${framework.name}_${transaction.id.slice(0, 8)}.pdf`);

              // 3. Keep localStorage for legacy support/local state
              const existingSoftware = JSON.parse(
                localStorage.getItem("software") || "[]"
              );

              existingSoftware.push({
                ...framework,
                purchasedAt: transaction.purchased_at,
                transactionId: transaction.id
              });

              localStorage.setItem("software", JSON.stringify(existingSoftware));

              alert(
                `Successfully purchased license for ${framework.name}! Invoice downloaded.`
              );
            } catch (e) {
              console.error("Error processing checkout:", e);
              alert("Checkout failed: " + (e instanceof Error ? e.message : String(e)));
            }
          }
        });
      }
    </script>
  </article>
</Layout>
